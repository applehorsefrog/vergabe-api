{
  "name": "vergabe-api",
  "version": "0.1.0",
  "private": true,
  "description": "German public procurement notices as a normalised JSON API, paid per call via x402 (USDC on Base). Data: Datenservice Öffentlicher Einkauf, CC0.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema:local": "wrangler d1 execute vergabe --local --file=schema.sql",
    "db:schema:remote": "wrangler d1 execute vergabe --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
